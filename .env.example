GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
POLL_INTERVAL_SECONDS=300
DATA_DIR=/data
# Per-user Discord webhooks and section filters live in $DATA_DIR/users.yaml — see data/users.example.yaml

# LLM (OpenAI-compatible; LiteLLM). Model names are whatever LiteLLM exposes.
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=
# Must match a model name in your LiteLLM config (see GET /models).
LLM_SCORE_MODEL=deepseek-v4-flash
# Separate, usually pricier model for tailoring a resume to a matched posting.
LLM_TAILOR_MODEL=deepseek-v4-pro
# One score may make two requests (a re-ask), so a ready Discord message can wait
# up to 2x this behind one scoring call.
LLM_TIMEOUT_SECONDS=120
# Cap on bullets kept per experience/project entry when tailoring.
MAX_BULLETS_PER_ENTRY=4
