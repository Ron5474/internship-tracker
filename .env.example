GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
POLL_INTERVAL_SECONDS=300
DATA_DIR=/data
# Per-user Discord webhooks and section filters live in $DATA_DIR/users.yaml — see data/users.example.yaml

# LLM (OpenAI-compatible; LiteLLM). Model names are whatever LiteLLM exposes.
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=
LLM_SCORE_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=120
